   acc[0] = [3141, 2217, -16, 2936]   as u32 hex = ['0xc45', '0x8a9', '0xfffffff0', '0xb78']
   acc[1] = [2760, 440, 2503, 6960]   as u32 hex = ['0xac8', '0x1b8', '0x9c7', '0x1b30']
